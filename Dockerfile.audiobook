FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 HF_HOME=/models AUDIOBOOK_SYNTH_PYTHON=/opt/tts/bin/python
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libsndfile1 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev
RUN uv venv /opt/tts --python 3.12 && uv pip install --python /opt/tts/bin/python 'vieneu==3.7.1'
COPY app ./app
CMD [".venv/bin/python", "-m", "app.audiobook_worker"]
